# ──────────────────────────────────────────────
# RailMadad-AI-Platform  —  Environment Variables
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME=RailMadad-AI-Platform
APP_ENV=development                        # development | staging | production
DEBUG=true
SECRET_KEY=<generate-a-strong-random-key>
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL + pgvector) ─────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/railmadad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=railmadad

# ── Redis (cache + Celery broker) ────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Vector Database ──────────────────────────
# If using Qdrant instead of pgvector, uncomment below:
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=railmadad_embeddings
VECTOR_DB_PROVIDER=[FILL: pgvector | qdrant]

# ── Auth (OTP + JWT) ────────────────────────
JWT_SECRET_KEY=<generate-a-strong-jwt-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ── LLM / AI Orchestration ──────────────────
LLM_PROVIDER=[FILL: gemini | llama | openrouter]
# -- Gemini --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
# -- OpenRouter --
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# -- Llama (self-hosted) --
LLAMA_API_URL=
LLAMA_MODEL=

# ── LangChain / LangGraph ───────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=railmadad

# ── Embeddings ───────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Speech-to-Text (Whisper) ────────────────
WHISPER_MODEL_SIZE=base                    # tiny | base | small | medium | large
OPENAI_API_KEY=                            # if using OpenAI Whisper API

# ── Computer Vision ─────────────────────────
CV_PROVIDER=[FILL: huggingface | nvidia | self-hosted]
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
NVIDIA_INFERENCE_URL=

# ── Classification & Sentiment ──────────────
CLASSIFICATION_STRATEGY=[FILL: bert | distilbert | llm-based | hybrid]
SENTIMENT_MODEL=nlptown/bert-base-multilingual-uncased-sentiment

# ── Forecasting ─────────────────────────────
FORECASTING_MODEL=[FILL: prophet | lstm | both]

# ── Maps ────────────────────────────────────
MAPS_PROVIDER=[FILL: google-maps | openstreetmap]
GOOGLE_MAPS_API_KEY=

# ── SMS / OTP Provider ─────────────────────
SMS_PROVIDER=[FILL: twilio | msg91 | sns]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=

# ── Email Provider ──────────────────────────
EMAIL_PROVIDER=[FILL: sendgrid | ses | resend | smtp]
SENDGRID_API_KEY=
# SES_ACCESS_KEY=
# SES_SECRET_KEY=
# SES_REGION=
EMAIL_FROM=noreply@railmadad.in

# ── Push Notifications ─────────────────────
PUSH_PROVIDER=[FILL: fcm | onesignal]
FCM_SERVER_KEY=
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=

# ── WebSocket ───────────────────────────────
WS_ENDPOINT=ws://localhost:8000/ws

# ── Frontend (Vite — prefix with VITE_) ────
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_GOOGLE_MAPS_KEY=
VITE_APP_NAME=RailMadad

# ── Monitoring ──────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin
ELASTICSEARCH_URL=http://localhost:9200

# ── Cloud / Deployment ──────────────────────
CLOUD_PROVIDER=[FILL: aws | azure | gcp | render]
# AWS-specific
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=railmadad-uploads

# ── Nginx ───────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443

# ── Misc ────────────────────────────────────
UPLOAD_MAX_SIZE_MB=25
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
